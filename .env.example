# =====================================================================================
#  CuraAI settings. Copy this file to .env and fill in your key:
#      Windows:  copy .env.example .env        macOS/Linux:  cp .env.example .env
#  Never commit .env (it is git-ignored; ADR-006: no secrets in the repo).
#  Read once by app/main.py. Check your settings any time with:  python -m curaai.app.check
# =====================================================================================


# -------------------------------------------------------------------------------------
#  1. WHICH AI MODEL READS THE PATIENT MESSAGES
# -------------------------------------------------------------------------------------
#  groq     Groq API, the team's AI model. Fill in section 2.                 <- default
#  local    built-in rule-based reader: no key, no internet (good fallback)
#  gemini   Google Gemini API. Fill in section 3 instead.
#  bedrock  AWS Bedrock. Fill in section 4 instead.
#  none     no reader at all (ADR-011 fallback: chart pull from the message date)
CURAAI_MODEL_BACKEND=groq


# -------------------------------------------------------------------------------------
#  2. GROQ API  (used when CURAAI_MODEL_BACKEND=groq)
# -------------------------------------------------------------------------------------
#  Free key: sign in at https://console.groq.com/keys, click "Create API Key", paste it
#  below (it starts with gsk_). Each teammate uses their own key. Synthetic data only.
#  Free tier: about 30 requests and 8,000 tokens per minute, 200,000 tokens per day.
CURAAI_GROQ_API_KEY=
CURAAI_GROQ_MODEL=openai/gpt-oss-20b      # any chat model your key lists; the setup check shows them
CURAAI_GROQ_REASONING_EFFORT=low          # low | medium | high; leave empty if a model rejects it
CURAAI_GROQ_TIMEOUT_S=60                  # seconds to wait for each answer
CURAAI_GROQ_FALLBACK_MODEL=               # optional backup model if the main one is busy


# -------------------------------------------------------------------------------------
#  3. GOOGLE GEMINI API  (only if CURAAI_MODEL_BACKEND=gemini)
# -------------------------------------------------------------------------------------
#  Free key: https://aistudio.google.com/apikey. Synthetic data only.
# CURAAI_GEMINI_API_KEY=
# CURAAI_GEMINI_MODEL=gemini-3.8-flash
# CURAAI_GEMINI_THINKING_LEVEL=low
# CURAAI_GEMINI_TIMEOUT_S=60
# CURAAI_GEMINI_FALLBACK_MODEL=           # backup if the main model is overloaded (HTTP 503)


# -------------------------------------------------------------------------------------
#  4. AWS BEDROCK  (only if CURAAI_MODEL_BACKEND=bedrock; also pip install -e ".[web,bedrock]")
# -------------------------------------------------------------------------------------
# CURAAI_BEDROCK_MODEL_ID=                # the model id enabled in your AWS account
# CURAAI_AWS_REGION=us-east-1             # credentials come from your AWS config, never this file


# -------------------------------------------------------------------------------------
#  5. AI USAGE LIMITS  (apply to Groq and Gemini; keep a free key inside its limits)
# -------------------------------------------------------------------------------------
CURAAI_AI_USE_FOR=reading                 # reading = only reading the message uses the AI (16 calls per demo)
                                          # all = every model step uses it (about 30 calls per demo)
CURAAI_AI_MAX_PER_MINUTE=8                # space requests out so the key isn't refused; 0 = no limit


# -------------------------------------------------------------------------------------
#  6. GOVERNANCE  (owned by Main; see README "Governance")
# -------------------------------------------------------------------------------------
CURAAI_HITL_APPROVERS=dr-demo             # physician ids allowed to approve a reply to the patient
CURAAI_MAX_MODEL_CALLS=12                 # per-case caps (Governance ADR 5 / ADR-011); a hit cap turns AI off
CURAAI_MAX_LOOKUPS=5
CURAAI_MAX_FOLLOW_UPS=2
CURAAI_MAX_CASE_COST_USD=0.25
CURAAI_DAILY_BUDGET_USD=5.00
CURAAI_FOLLOW_UP_TIMEOUT_HOURS=24         # unanswered follow-up -> handed to the physician incomplete


# -------------------------------------------------------------------------------------
#  7. DEMO AND SERVER  (usually leave as is)
# -------------------------------------------------------------------------------------
CURAAI_EHR_ADAPTER=mock_epic              # only mock_epic until SMART on FHIR (ADR-017)
CURAAI_DRUG_ADAPTER=mock                  # mock | openfda (openfda needs internet)
CURAAI_MOCK_EPIC_API_KEY=mock-curaai-key-0000
CURAAI_AUDIT_LOG_PATH=./audit.jsonl       # the run log (/runlog) is read from this file
CURAAI_CLINIC_TZ=America/New_York
CURAAI_CLOCK_NOW=2026-10-16T13:00:00      # freeze "today" to match MockChart; empty = real clock
# CURAAI_MOCKCHART_PAGE=                  # default: the first MockChart*.html in this folder
CURAAI_PRICE_IN_PER_MTOK=3.00             # placeholder prices until the vendor quote
CURAAI_PRICE_OUT_PER_MTOK=15.00
CURAAI_HOST=127.0.0.1
CURAAI_PORT=8000
CURAAI_SWEEP_SECONDS=60                   # how often the 24-hour timeout sweep runs
