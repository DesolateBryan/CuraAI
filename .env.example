# Copy to .env and fill in. Never commit .env (ADR-006: no secrets in the repo).
# Read once by app/main.py (Ring 4). Nothing in Rings 1-2 reads the environment.
#
# The ONE thing to fill in: CURAAI_GROQ_API_KEY (free, https://console.groq.com/keys).
# No key? Set CURAAI_MODEL_BACKEND=local to run the whole demo with the rule-based reader.

CURAAI_EHR_ADAPTER=mock_epic          # only mock_epic until SMART on FHIR (ADR-017)
CURAAI_DRUG_ADAPTER=mock              # mock | openfda (openfda needs internet)
CURAAI_MODEL_BACKEND=groq             # groq | local | gemini | bedrock | none
                                      #   groq:    Groq, the team's AI model (needs CURAAI_GROQ_API_KEY below)
                                      #   local:   rule-based demo reader, no cloud account (default with no .env)
                                      #   gemini:  Google Gemini (needs CURAAI_GEMINI_API_KEY below)
                                      #   bedrock: the real model through AWS Bedrock
                                      #   none:    no reader at all; ADR-011 fallback (chart pull from message date)
CURAAI_GROQ_API_KEY=                  # paste your key here: https://console.groq.com/keys  (synthetic data only)
# CURAAI_GROQ_MODEL=openai/gpt-oss-20b
# CURAAI_GROQ_REASONING_EFFORT=low     # empty = model default; not every model accepts it
# CURAAI_GROQ_TIMEOUT_S=60
# CURAAI_GROQ_FALLBACK_MODEL=         # backup model if the main one is busy; the setup check lists names

# Groq and Gemini free keys have per-minute and daily limits. These keep a demo inside them:
# CURAAI_AI_USE_FOR=reading           # reading = only reading the patient's message uses the AI (default);
#                                     # all = every model step uses it (about 2x the calls)
# CURAAI_AI_MAX_PER_MINUTE=8          # space AI requests out so a free key isn't refused; 0 = no limit

# CURAAI_GEMINI_API_KEY=              # free key: https://aistudio.google.com/apikey  (synthetic data only)
# CURAAI_GEMINI_MODEL=gemini-3.8-flash
# CURAAI_GEMINI_THINKING_LEVEL=low
# CURAAI_GEMINI_TIMEOUT_S=60          # seconds to wait for each Gemini answer
# CURAAI_GEMINI_FALLBACK_MODEL=       # backup model if the main one is overloaded (HTTP 503);
#                                     # python -m curaai.app.check lists the names your key can use
# CURAAI_BEDROCK_MODEL_ID=            # required for bedrock, e.g. the Claude model id enabled in your AWS account
# CURAAI_AWS_REGION=us-east-1         # AWS credentials come from the normal AWS config, never from this file

CURAAI_MOCK_EPIC_API_KEY=mock-curaai-key-0000
CURAAI_AUDIT_LOG_PATH=./audit.jsonl
CURAAI_CLINIC_TZ=America/New_York
CURAAI_CLOCK_NOW=2026-10-16T13:00:00  # freeze "today" to match MockChart; leave empty for the real clock
# CURAAI_MOCKCHART_PAGE=              # default: the first MockChart*.html in the working directory

CURAAI_DAILY_BUDGET_USD=5.00
CURAAI_PRICE_IN_PER_MTOK=3.00         # placeholder until the vendor quote
CURAAI_PRICE_OUT_PER_MTOK=15.00
CURAAI_HOST=127.0.0.1
CURAAI_PORT=8000
CURAAI_SWEEP_SECONDS=60               # how often the 24-hour timeout sweep runs

# ---- governance (owned by Main; see README "Governance") -------------------------------------------
CURAAI_HITL_APPROVERS=dr-demo         # physician ids allowed to approve a reply to the patient (HITL gate)
CURAAI_MAX_MODEL_CALLS=12             # per-case caps (Governance ADR 5 / ADR-011); a hit cap switches AI off
CURAAI_MAX_LOOKUPS=5
CURAAI_MAX_FOLLOW_UPS=2
CURAAI_MAX_CASE_COST_USD=0.25
CURAAI_FOLLOW_UP_TIMEOUT_HOURS=24     # unanswered follow-up -> handed to the physician incomplete
